<odoo>
 <record id="action_demo_products" model="ir.actions.act_window">
  <field name="name">Truth Demo Menu</field><field name="res_model">product.template</field>
  <field name="view_mode">kanban,list,form</field>
  <field name="domain">[('default_code', '=like', 'TRUTH-DEMO-%')]</field>
