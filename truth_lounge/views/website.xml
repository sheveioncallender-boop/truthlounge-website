<odoo>
 <template id="brand_layout" inherit_id="website.layout" name="Truth Native Website Branding">
  <xpath expr="//div[@id='wrapwrap']" position="attributes"><attribute name="t-attf-class" add="#{'truth-site' if website.truth_enabled else ''}" separator=" "/></xpath>
 </template>

 <template id="footer" name="Truth contact band"><section class="truth-contact-band"><div class="truth-container"><div><span class="truth-eyebrow">FIND YOUR WAY TO TRUTH</span><h2>Make a night of it.</h2><p t-esc="website.truth_address"/></div><a class="truth-button" href="/truth/visit">Plan your visit <span>↗</span></a></div></section></template>

 <template id="home" name="Truth Lounge &amp; Restaurant">
  <t t-call="website.layout"><t t-set="additional_title">Truth Lounge &amp; Restaurant | Woodbrook</t>
   <div id="wrap" class="truth-page oe_structure">
    <section class="truth-hero"><div class="truth-container truth-hero-grid"><div class="truth-hero-copy"><span class="truth-eyebrow">ARIAPITA AVENUE · WOODBROOK</span><h1>Good food.<br/>Great company.<br/><em>That’s Truth.</em></h1><p>Your place to dine, unwind, and enjoy the evening. Welcome to Truth Lounge &amp; Restaurant.</p><div class="truth-actions"><a class="truth-button" href="/shop">Explore the menu <span>↗</span></a><a class="truth-text-link" href="/truth/reserve">Book a table →</a></div><div class="truth-hero-note"><span class="truth-gold">✦</span> DINING · DRINKS · GOOD TIMES</div></div><div class="truth-brand-art"><img src="/truth_lounge/static/src/img/truth-brand.jpg" alt="Truth Lounge and Restaurant — black and gold brand artwork" fetchpriority="high"/></div></div></section>
    <div class="truth-ribbon"><span>COME FOR THE FOOD</span><span>✦</span><span>STAY FOR THE COMPANY</span><span>✦</span><span>MAKE IT TRUTH</span></div>
    <section class="truth-section"><div class="truth-container"><div class="truth-section-heading"><div><span class="truth-eyebrow">YOUR EVENING, YOUR WAY</span><h2>A little appetite.<br/>A lot to look forward to.</h2></div><p>From a relaxed meal to your next celebration, find your reason to come together.</p></div><div class="truth-three"><a href="/shop" class="truth-experience"><span class="truth-symbol">✧</span><span class="truth-eyebrow">AT THE TABLE</span><h3>Something to savour.</h3><p>Explore our food and drinks menu, and find your next favourite.</p><span class="truth-text-link">View food &amp; drinks ↗</span></a><a href="/event" class="truth-experience"><span class="truth-symbol">♫</span><span class="truth-eyebrow">AFTER HOURS</span><h3>Find your kind of night.</h3><p>See what’s coming up and make plans with your favourite people.</p><span class="truth-text-link">See what’s on ↗</span></a><a href="/truth/private-events" class="truth-experience"><span class="truth-symbol">✦</span><span class="truth-eyebrow">YOUR OCCASION</span><h3>Make it memorable.</h3><p>Bring your birthday, team gathering, or special occasion to Truth.</p><span class="truth-text-link">Plan a private event ↗</span></a></div></div></section>
    <section class="truth-section truth-light" t-if="products"><div class="truth-container"><div class="truth-section-heading"><div><span class="truth-eyebrow">FROM OUR MENU</span><h2>Find your next favourite.</h2></div><a href="/shop" class="truth-text-link">Explore the full menu →</a></div><div class="truth-product-grid"><a t-foreach="products" t-as="product" t-att-href="product.website_url" class="truth-product"><div class="truth-product-image"><img t-if="product.image_1920" t-att-src="'/web/image/product.template/%s/image_512' % product.id" t-att-alt="product.name" loading="lazy"/><span t-else="" class="truth-symbol">✦</span></div><span class="truth-eyebrow" t-esc="'FROM OUR MENU'"/><h3 t-esc="product.name"/><span class="truth-text-link">View &amp; order →</span></a></div></div></section>
    <section class="truth-section truth-story"><div class="truth-container truth-two"><div><span class="truth-eyebrow">WELCOME TO THE AVENUE</span><h2>A place to unwind.<br/><em>A reason to return.</em></h2></div><div><p>At the corner of Ariapita Avenue and Belle Smythe Street, Truth brings food, drinks, and company together.</p><p>Drop in for a meal, catch up after work, or gather everyone for an occasion worth celebrating.</p><a href="/truth/about" class="truth-text-link">Get to know Truth →</a></div></div></section>
    <t t-call="truth_lounge.footer"/>
   </div>
  </t>
 </template>

 <template id="about" name="Our Story — Truth"><t t-call="website.layout"><t t-set="additional_title">Our Story | Truth Lounge</t><div id="wrap" class="truth-page oe_structure"><section class="truth-section"><div class="truth-container truth-two"><div><span class="truth-eyebrow">LOUNGE &amp; RESTAURANT</span><h1>Meet you<br/><em>at Truth.</em></h1><p class="truth-lead">A meal with friends. A drink after work. An evening worth making time for.</p><p>Truth Lounge &amp; Restaurant brings dining and social evenings together in Woodbrook. Find us at the corner of Ariapita Avenue and Belle Smythe Street.</p><p>Explore our menu, see what’s on, or speak with us about your next gathering.</p><div class="truth-actions"><a href="/shop" class="truth-button">Discover the menu ↗</a><a href="/truth/visit" class="truth-text-link">Find us →</a></div></div><img class="truth-about-art" src="/truth_lounge/static/src/img/truth-brand.jpg" alt="Truth Lounge and Restaurant"/></div></section><t t-call="truth_lounge.footer"/></div></t></template>

 <template id="private_events" name="Private Events — Truth"><t t-call="website.layout"><t t-set="additional_title">Private Events | Truth Lounge</t><div id="wrap" class="truth-page oe_structure"><section class="truth-section truth-centered"><div class="truth-container"><span class="truth-eyebrow">SOME OCCASIONS DESERVE TRUTH</span><h1>Your people.<br/><em>Your occasion.</em></h1><p class="truth-lead">Bring everyone together for a celebration on the Avenue.</p><a href="/truth/reserve?kind=event" class="truth-button">Enquire about your event ↗</a></div></section><section class="truth-section truth-light"><div class="truth-container truth-three"><article><h3>Birthdays &amp; celebrations</h3><p>Tell us who you’re celebrating, your preferred date, and the size of your group.</p></article><article><h3>After-work gatherings</h3><p>Make time for the team. Enquire about an evening for colleagues and friends.</p></article><article><h3>Private functions</h3><p>Share your plans with us so we can discuss availability and suitable arrangements.</p></article></div></section><section class="truth-section"><div class="truth-container truth-two"><h2>Let’s plan<br/><em>the details.</em></h2><div><p>Send your preferred date, number of guests, and a little about your occasion. Our team will follow up to discuss your request.</p><p>Availability, menus, pricing, and any deposit requirements are confirmed with the team before your booking is final.</p><a href="/truth/reserve?kind=event" class="truth-text-link">Start your enquiry →</a></div></div></section></div></t></template>

 <template id="gallery" name="Gallery — Truth"><t t-call="website.layout"><t t-set="additional_title">Gallery | Truth Lounge</t><div id="wrap" class="truth-page oe_structure"><section class="truth-section"><div class="truth-container"><span class="truth-eyebrow">A TASTE OF TRUTH</span><h1>The moments.<br/><em>The memories.</em></h1><div t-if="photos" class="truth-gallery"><figure t-foreach="photos" t-as="photo"><img t-att-src="'/truth/photo/%s' % photo.id" t-att-alt="photo.name" loading="lazy"/><figcaption t-esc="photo.name"/></figure></div><div t-else="" class="truth-social-card"><p>See the latest moments, food, and evenings from Truth on our social pages.</p><div class="truth-actions"><a class="truth-button" t-att-href="website.social_instagram" target="_blank" rel="noopener">Explore Instagram ↗</a><a class="truth-text-link" t-att-href="website.social_facebook" target="_blank" rel="noopener">Visit Facebook ↗</a></div></div></div></section><t t-call="truth_lounge.footer"/></div></t></template>

 <template id="visit" name="Visit Truth"><t t-call="website.layout"><t t-set="additional_title">Visit &amp; Contact | Truth Lounge</t><div id="wrap" class="truth-page oe_structure"><section class="truth-section"><div class="truth-container truth-two"><div><span class="truth-eyebrow">IN THE HEART OF WOODBROOK</span><h1>We’ll see you<br/><em>at Truth.</em></h1><p class="truth-lead" t-esc="website.truth_address"/><a class="truth-button" href="https://www.google.com/maps/search/?api=1&amp;query=Truth+Lounge+Ariapita+Avenue+Belle+Smythe+Street+Trinidad" target="_blank" rel="noopener">Get directions ↗</a></div><div class="truth-panel"><h3>Plan your visit</h3><div t-if="website.truth_hours"><span class="truth-eyebrow">OPENING HOURS</span><p class="truth-preline" t-esc="website.truth_hours"/></div><div t-if="website.truth_phone"><span class="truth-eyebrow">CALL US</span><p><a t-att-href="'tel:' + website.truth_phone" t-esc="website.truth_phone"/></p></div><p>For a table or private function, send a request and the team will get back to you.</p><a href="/truth/reserve" class="truth-text-link">Book a table →</a><hr/><a t-att-href="website.social_instagram" target="_blank" rel="noopener">Instagram ↗</a> · <a t-att-href="website.social_facebook" target="_blank" rel="noopener">Facebook ↗</a></div></div></section></div></t></template>

 <template id="reserve" name="Reservations — Truth"><t t-call="website.layout"><t t-set="additional_title">Reservations | Truth Lounge</t><div id="wrap" class="truth-page"><section class="truth-section"><div class="truth-container truth-two"><div class="oe_structure"><span class="truth-eyebrow">MAKE TIME FOR TRUTH</span><h1>A table.<br/>An occasion.<br/><em>A good time.</em></h1><p class="truth-lead">Tell us what you have in mind.</p><p>All requests are subject to availability and confirmation by our team. Dates and times are in Trinidad &amp; Tobago time.</p><p><a href="/truth/visit" class="truth-text-link">Location &amp; contact →</a></p></div><div class="truth-panel"><div t-if="submitted" role="status"><span class="truth-eyebrow">REQUEST RECEIVED</span><h2>Thank you.</h2><p>Our team will review your request and contact you. Your booking is confirmed only after you hear from us.</p><a href="/truth" class="truth-button">Back to Truth →</a></div><form t-else="" action="/truth/reserve/submit" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><div t-if="error" class="alert alert-danger" role="alert" t-esc="error"/><div class="truth-honeypot" aria-hidden="true"><label>Company URL<input name="company_url" tabindex="-1" autocomplete="off"/></label></div><label for="truth-name">Your name</label><input id="truth-name" class="form-control" name="name" t-att-value="values.get('name', '')" required="required" maxlength="120" autocomplete="name"/><div class="truth-form-row"><div><label for="truth-email">Email</label><input id="truth-email" class="form-control" name="email" type="email" t-att-value="values.get('email', '')" required="required" maxlength="180" autocomplete="email"/></div><div><label for="truth-phone">Phone</label><input id="truth-phone" class="form-control" name="phone" type="tel" t-att-value="values.get('phone', '')" required="required" maxlength="40" autocomplete="tel"/></div></div><label for="truth-kind">What are you planning?</label><select id="truth-kind" class="form-select" name="kind"><option value="table" t-att-selected="values.get('kind', request.params.get('kind')) != 'event'">Table reservation</option><option value="event" t-att-selected="values.get('kind', request.params.get('kind')) == 'event'">Private event</option></select><div class="truth-form-row"><div><label for="truth-date">Preferred date &amp; time</label><input id="truth-date" class="form-control" type="datetime-local" name="requested_at" t-att-value="values.get('requested_at', '')" required="required"/></div><div><label for="truth-guests">Number of guests</label><input id="truth-guests" class="form-control" type="number" name="guests" min="1" max="500" t-att-value="values.get('guests', 2)" required="required"/></div></div><label for="truth-note">Anything we should know?</label><textarea id="truth-note" class="form-control" name="note" rows="4" maxlength="2000" placeholder="Occasion, accessibility needs, or questions" t-esc="values.get('note', '')"/><p class="truth-form-help">We’ll use these details to respond to your request.</p><button type="submit" class="truth-button">Send request ↗</button></form></div></div></section></div></t></template>

  <template id="truth_footer_layout" inherit_id="website.layout" name="Truth Website Footer" priority="90">
  <xpath expr="//div[@id='footer']" position="attributes"><attribute name="t-if">not no_footer and not website.truth_enabled</attribute></xpath>
  <xpath expr="//div[@id='footer']" position="after"><div t-if="website.truth_enabled and not no_footer" id="truth-footer" class="truth-container py-5"><div class="row g-4"><div class="col-md-5"><h4>Truth Lounge &amp; Restaurant</h4><p t-esc="website.truth_address"/><p t-if="website.truth_hours" class="truth-preline" t-esc="website.truth_hours"/></div><div class="col-md-3"><a href="/shop">Food &amp; Drinks</a><br/><a href="/truth/reserve">Book a Table</a><br/><a href="/truth/private-events">Private Events</a></div><div class="col-md-4"><a t-if="website.truth_phone" t-att-href="'tel:' + website.truth_phone" t-esc="website.truth_phone"/><br t-if="website.truth_phone"/><a t-att-href="website.social_instagram" target="_blank" rel="noopener">Instagram ↗</a><br/><a t-att-href="website.social_facebook" target="_blank" rel="noopener">Facebook ↗</a></div></div></div></xpath>
  <xpath expr="//span[hasclass('o_footer_copyright_name')]" position="attributes"><attribute name="t-if">not website.truth_enabled</attribute></xpath>
  <xpath expr="//span[hasclass('o_footer_copyright_name')]" position="after"><span t-if="website.truth_enabled">© Truth Lounge &amp; Restaurant</span></xpath>
 </template>
 <template id="truth_header_contact" inherit_id="website.header_text_element" name="Truth Native Header Contact">
  <xpath expr="//li" position="attributes"><attribute name="t-if">not website.truth_enabled</attribute></xpath>
  <xpath expr="//li" position="after"><li t-if="website.truth_enabled and website.truth_phone" t-attf-class="#{_item_class}"><a class="nav-link o_nav-link_secondary" t-att-href="'tel:' + website.truth_phone"><i class="fa fa-phone me-2"/><span t-esc="website.truth_phone"/></a></li></xpath>
 </template>
</odoo>
