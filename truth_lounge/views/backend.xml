<odoo>
 <record id="website_form" model="ir.ui.view"><field name="name">website.truth.settings</field><field name="model">website</field><field name="inherit_id" ref="website.view_website_form"/><field name="arch" type="xml"><xpath expr="//sheet" position="inside"><group string="Truth Lounge" groups="base.group_system"><field name="truth_enabled"/><field name="truth_address"/><field name="truth_phone"/><field name="truth_hours"/><button name="action_setup_truth" string="Apply Truth branding and navigation" type="object" class="btn-primary" confirm="Apply Truth branding, logo, social links, navigation and homepage to this website? Existing products, checkout and orders are preserved."/></group></xpath></field></record>
 <record id="booking_list" model="ir.ui.view"><field name="name">truth.booking.list</field><field name="model">truth.booking</field><field name="arch" type="xml"><list decoration-info="state == 'new'"><field name="requested_at"/><field name="name"/><field name="kind"/><field name="guests"/><field name="phone"/><field name="assigned_to"/><field name="state"/></list></field></record>
 <record id="booking_form" model="ir.ui.view"><field name="name">truth.booking.form</field><field name="model">truth.booking</field><field name="arch" type="xml"><form><header><field name="state" widget="statusbar" options="{'clickable': True}"/></header><sheet><div class="alert alert-info">This is a reservation request. Contact the guest and check availability before confirming. Table allocation remains in the restaurant's normal workflow.</div><group><group><field name="name"/><field name="kind"/><field name="requested_at"/><field name="guests"/></group><group><field name="email"/><field name="phone"/><field name="assigned_to"/><field name="website_id"/></group></group><field name="note"/></sheet><chatter/></form></field></record>
 <record id="gallery_list" model="ir.ui.view"><field name="name">truth.gallery.list</field><field name="model">truth.gallery</field><field name="arch" type="xml"><list><field name="sequence" widget="handle"/><field name="name"/><field name="image" widget="image" options="{'size': [64,64]}"/><field name="website_id"/><field name="published"/></list></field></record>
 <record id="gallery_form" model="ir.ui.view"><field name="name">truth.gallery.form</field><field name="model">truth.gallery</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="website_id"/><field name="published"/><field name="sequence"/></group><field name="image" widget="image"/></sheet></form></field></record>
 <record id="action_bookings" model="ir.actions.act_window"><field name="name">Reservations &amp; Private Events</field><field name="res_model">truth.booking</field><field name="view_mode">list,form</field></record>
 <record id="action_gallery" model="ir.actions.act_window"><field name="name">Website Gallery</field><field name="res_model">truth.gallery</field><field name="view_mode">list,form</field></record>
 <record id="action_websites" model="ir.actions.act_window"><field name="name">Website Branding</field><field name="res_model">website</field><field name="view_mode">list,form</field></record>
 <record id="action_open_website" model="ir.actions.act_url"><field name="name">Truth Website</field><field name="url">/</field><field name="target">self</field></record>
 <menuitem id="menu_truth_website" name="Truth Website" sequence="16" groups="group_website_manager,base.group_system"/>
 <menuitem id="menu_website_open" name="Open Website" parent="menu_truth_website" action="action_open_website" sequence="5"/>
 <menuitem id="menu_bookings" name="Reservations &amp; Private Events" parent="menu_truth_website" action="action_bookings" sequence="30" groups="group_website_manager,base.group_system"/>
 <menuitem id="menu_gallery" name="Website Gallery" parent="menu_truth_website" action="action_gallery" sequence="40" groups="group_website_manager,base.group_system"/>
 <menuitem id="menu_settings" name="Website Branding" parent="menu_truth_website" action="action_websites" sequence="90" groups="base.group_system"/>
</odoo>
