<odoo>
 <record id="website_form" model="ir.ui.view"><field name="name">website.truth.settings</field><field name="model">website</field><field name="inherit_id" ref="website.view_website_form"/><field name="arch" type="xml"><xpath expr="//sheet" position="inside"><group string="Truth Lounge" groups="base.group_system"><field name="truth_enabled"/><field name="truth_address"/><field name="truth_phone"/><field name="truth_hours"/><button name="action_setup_truth" string="Apply Truth branding and navigation" type="object" class="btn-primary" confirm="Apply Truth branding, logo, social links, navigation and homepage to this website? Existing products, checkout and orders are preserved."/></group></xpath></field></record>
 <record id="product_form" model="ir.ui.view"><field name="name">product.truth.station</field><field name="model">product.template</field><field name="inherit_id" ref="product.product_template_only_form_view"/><field name="arch" type="xml"><xpath expr="//sheet" position="inside"><group string="Truth Preparation"><field name="truth_station"/></group></xpath></field></record>
 <record id="pos_form" model="ir.ui.view"><field name="name">pos.truth.settings</field><field name="model">pos.config</field><field name="inherit_id" ref="point_of_sale.pos_config_view_form"/><field name="arch" type="xml"><xpath expr="//sheet" position="inside"><group string="Truth Preparation Display"><field name="truth_kds_enabled"/><div class="text-muted">Mirrors saved native POS orders to the kitchen and bar display. Preparation stages do not change billing, payments or stock.</div></group></xpath></field></record>
 <record id="ticket_list" model="ir.ui.view"><field name="name">truth.ticket.list</field><field name="model">truth.ticket</field><field name="arch" type="xml"><list create="0" edit="0" delete="0" decoration-danger="amended"><field name="create_date"/><field name="name"/><field name="station"/><field name="table_name"/><field name="product_name"/><field name="quantity"/><field name="stage"/><field name="amended"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
 <record id="ticket_form" model="ir.ui.view"><field name="name">truth.ticket.form</field><field name="model">truth.ticket</field><field name="arch" type="xml"><form create="0" edit="0" delete="0"><sheet><group><field name="name"/><field name="pos_order_id"/><field name="sale_order_id"/><field name="station"/><field name="table_name"/><field name="product_name"/><field name="quantity"/><field name="note"/><field name="stage"/><field name="revision"/><field name="amended"/><field name="cancellation_reason"/><field name="handled_by"/><field name="handled_at"/></group></sheet><chatter/></form></field></record>
 <record id="booking_list" model="ir.ui.view"><field name="name">truth.booking.list</field><field name="model">truth.booking</field><field name="arch" type="xml"><list decoration-info="state == 'new'"><field name="requested_at"/><field name="name"/><field name="kind"/><field name="guests"/><field name="phone"/><field name="assigned_to"/><field name="state"/></list></field></record>
 <record id="booking_form" model="ir.ui.view"><field name="name">truth.booking.form</field><field name="model">truth.booking</field><field name="arch" type="xml"><form><header><field name="state" widget="statusbar" options="{'clickable': True}"/></header><sheet><div class="alert alert-info">This is a reservation request. Contact the guest and check availability before confirming. Table allocation remains in the restaurant's normal workflow.</div><group><group><field name="name"/><field name="kind"/><field name="requested_at"/><field name="guests"/></group><group><field name="email"/><field name="phone"/><field name="assigned_to"/><field name="website_id"/></group></group><field name="note"/></sheet><chatter/></form></field></record>
 <record id="gallery_list" model="ir.ui.view"><field name="name">truth.gallery.list</field><field name="model">truth.gallery</field><field name="arch" type="xml"><list><field name="sequence" widget="handle"/><field name="name"/><field name="image" widget="image" options="{'size': [64,64]}"/><field name="website_id"/><field name="published"/></list></field></record>
 <record id="gallery_form" model="ir.ui.view"><field name="name">truth.gallery.form</field><field name="model">truth.gallery</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="website_id"/><field name="published"/><field name="sequence"/></group><field name="image" widget="image"/></sheet></form></field></record>
 <record id="action_tickets" model="ir.actions.act_window"><field name="name">Preparation History</field><field name="res_model">truth.ticket</field><field name="view_mode">list,form</field></record>
 <record id="action_bookings" model="ir.actions.act_window"><field name="name">Reservations &amp; Private Events</field><field name="res_model">truth.booking</field><field name="view_mode">list,form</field></record>
 <record id="action_gallery" model="ir.actions.act_window"><field name="name">Website Gallery</field><field name="res_model">truth.gallery</field><field name="view_mode">list,form</field></record>
 <record id="action_websites" model="ir.actions.act_window"><field name="name">Website Branding</field><field name="res_model">website</field><field name="view_mode">list,form</field></record>
 <record id="action_kitchen" model="ir.actions.act_url"><field name="name">Kitchen &amp; Bar Display</field><field name="url">/truth/kitchen</field><field name="target">self</field></record>
 <menuitem id="menu_truth" name="Truth Lounge" sequence="15" groups="group_operator,base.group_system"/>
 <menuitem id="menu_display" name="Kitchen &amp; Bar Display" parent="menu_truth" action="action_kitchen" sequence="10"/>
 <menuitem id="menu_tickets" name="Preparation History" parent="menu_truth" action="action_tickets" sequence="20"/>
 <menuitem id="menu_bookings" name="Reservations &amp; Private Events" parent="menu_truth" action="action_bookings" sequence="30" groups="group_manager,base.group_system"/>
 <menuitem id="menu_gallery" name="Website Gallery" parent="menu_truth" action="action_gallery" sequence="40" groups="group_manager,base.group_system"/>
 <menuitem id="menu_products" name="Menu Products" parent="menu_truth" action="point_of_sale.product_template_action_pos_product" sequence="50" groups="point_of_sale.group_pos_manager"/>
 <menuitem id="menu_settings" name="Website Branding" parent="menu_truth" action="action_websites" sequence="90" groups="base.group_system"/>
</odoo>
