 <record id="booking_company" model="ir.rule"><field name="name">Truth bookings: company</field><field name="model_id" ref="model_truth_booking"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
 <record id="gallery_company" model="ir.rule"><field name="name">Truth gallery: company</field><field name="model_id" ref="model_truth_gallery"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
</odoo>
