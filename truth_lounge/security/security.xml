<odoo>
 <record id="category_truth" model="ir.module.category"><field name="name">Truth Lounge</field></record>
 <record id="privilege_truth" model="res.groups.privilege"><field name="name">Restaurant Operations</field><field name="category_id" ref="category_truth"/></record>
 <record id="group_operator" model="res.groups"><field name="name">Preparation Display User</field><field name="privilege_id" ref="privilege_truth"/><field name="implied_ids" eval="[(4, ref('base.group_user'))]"/></record>
 <record id="group_manager" model="res.groups"><field name="name">Truth Manager</field><field name="privilege_id" ref="privilege_truth"/><field name="implied_ids" eval="[(4, ref('group_operator'))]"/></record>
 <record id="ticket_company" model="ir.rule"><field name="name">Truth tickets: company</field><field name="model_id" ref="model_truth_ticket"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
 <record id="booking_company" model="ir.rule"><field name="name">Truth bookings: company</field><field name="model_id" ref="model_truth_booking"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
 <record id="gallery_company" model="ir.rule"><field name="name">Truth gallery: company</field><field name="model_id" ref="model_truth_gallery"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
</odoo>
