<odoo><record id="product_form" model="ir.ui.view"><field name="name">product.truth.station</field><field name="model">product.template</field><field name="inherit_id" ref="product.product_template_only_form_view"/><field name="arch" type="xml"><xpath expr="//sheet" position="inside"><group string="Truth Preparation"><field name="truth_station"/></group></xpath></field></record>
 <record id="pos_form" model="ir.ui.view"><field name="name">pos.truth.settings</field><field name="model">pos.config</field><field name="inherit_id" ref="point_of_sale.pos_config_view_form"/><field name="arch" type="xml"><xpath expr="//sheet" position="inside"><group string="Truth Kitchen Display"><div class="text-muted">Configure registers and stations in Truth Kitchen Display → Displays. Preparation progress is separate from native POS order processing.</div></group></xpath></field></record>
 <record id="ticket_list" model="ir.ui.view"><field name="name">truth.ticket.list</field><field name="model">truth.ticket</field><field name="arch" type="xml"><list create="0" edit="0" delete="0" decoration-danger="amended"><field name="create_date"/><field name="name"/><field name="station"/><field name="table_name"/><field name="product_name"/><field name="quantity"/><field name="stage"/><field name="amended"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
 <record id="ticket_form" model="ir.ui.view"><field name="name">truth.ticket.form</field><field name="model">truth.ticket</field><field name="arch" type="xml"><form create="0" edit="0" delete="0"><sheet><group><field name="name"/><field name="pos_order_id"/><field name="sale_order_id"/><field name="station"/><field name="table_name"/><field name="product_name"/><field name="quantity"/><field name="note"/><field name="stage"/><field name="revision"/><field name="amended"/><field name="cancellation_reason"/><field name="handled_by"/><field name="handled_at"/></group></sheet><chatter/></form></field></record>
 <record id="action_tickets" model="ir.actions.act_window"><field name="name">Preparation History</field><field name="res_model">truth.ticket</field><field name="view_mode">list,form</field></record>
 <record id="action_kitchen" model="ir.actions.act_url"><field name="name">Kitchen &amp; Bar Display</field><field name="url">/truth/kitchen</field><field name="target">self</field></record>
 <menuitem id="menu_truth" name="Truth Kitchen Display" sequence="15" groups="group_operator,base.group_system"/>
 <menuitem id="menu_display" name="Displays" parent="menu_truth" action="action_displays" sequence="10"/>
 <menuitem id="menu_tickets" name="Preparation History" parent="menu_truth" action="action_tickets" sequence="20"/>
 <menuitem id="menu_products" name="Product Routing" parent="menu_truth" action="point_of_sale.product_template_action_pos_product" sequence="50" groups="point_of_sale.group_pos_manager"/>
 </odoo>
