<odoo><template id="kitchen" name="Truth Kitchen and Bar Display"><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Truth · Preparation Display</title><link rel="stylesheet" href="/truth_kitchen_display/static/src/css/kitchen.css"/></head><body t-att-data-display-id="display.id"><header class="kds-header"><div><img class="kds-logo" src="/truth_kitchen_display/static/src/img/truth-brand.jpg" alt="Truth Lounge and Restaurant"/><span id="display-name" t-esc="display.name"/></div><nav><a href="/truth/kitchen">Displays</a><a t-att-href="configuration_url">Configuration</a><a href="/odoo">Back to Odoo</a><button id="sound-start">Enable sound</button><button id="sound-test">Test sound</button><label>Volume <input id="volume" type="range" min="0" max="100" value="60"/></label><button id="fullscreen">Full screen</button></nav></header><main><div class="kds-toolbar"><div class="kds-tabs" role="group" aria-label="Preparation station"><button data-station="all" class="active">All stations</button><button data-station="kitchen">Kitchen</button><button data-station="bar">Bar</button></div><label><input type="checkbox" id="images" checked="checked"/> Product images</label><label><input type="checkbox" id="closed"/> Show closed</label><span id="status" role="status">Connecting…</span></div><p class="kds-note">Preparation progress only. Billing, refunds, stock and payments stay in Odoo’s standard workflow.</p><div id="board" class="kds-board" aria-live="polite"/><div id="error" role="alert"/></main><script src="/truth_kitchen_display/static/src/js/kitchen.js" defer="defer"/></body></html></template>
