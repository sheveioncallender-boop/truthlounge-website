<odoo>
 <record id="display_list" model="ir.ui.view"><field name="name">truth.display.list</field><field name="model">truth.display</field><field name="arch" type="xml"><list><field name="name"/><field name="station"/><field name="pos_config_ids" widget="many2many_tags"/><field name="include_website_orders"/><field name="company_id" groups="base.group_multi_company"/><button name="action_open_display" string="Open Display" type="object" icon="fa-external-link"/></list></field></record>
 <record id="display_form" model="ir.ui.view"><field name="name">truth.display.form</field><field name="model">truth.display</field><field name="arch" type="xml"><form><header><button name="action_open_display" string="Open Display" type="object" class="oe_highlight"/></header><sheet><widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/><div class="oe_title"><label for="name"/><h1><field name="name" placeholder="e.g. Main Kitchen"/></h1></div><field name="active" invisible="1"/><group><group string="Order sources"><field name="company_id" groups="base.group_multi_company"/><field name="company_id" invisible="1" groups="!base.group_multi_company"/><field name="pos_config_ids" widget="many2many_tags" domain="[('company_id', '=', company_id)]"/><field name="include_website_orders"/><div class="text-muted" colspan="2">Choose the registers to display. Website orders require Odoo eCommerce and include confirmed orders in this company. Set each product's Truth preparation station to Kitchen or Bar.</div></group><group string="Routing"><field name="station"/><field name="category_ids" widget="many2many_tags"/><div class="text-muted" colspan="2">Empty categories includes every category. Screens showing the same item share preparation progress.</div></group></group><notebook><page string="Display"><group><group><field name="refresh_seconds"/><field name="late_minutes"/><field name="closed_minutes"/><field name="show_images"/></group><group string="Sound alerts"><field name="sound_enabled"/><field name="sound_volume" invisible="not sound_enabled"/><field name="repeat_seconds" invisible="not sound_enabled"/><div class="text-muted" colspan="2">Click Enable sound on the display once after opening it. Set repeat to zero for new-item alerts only.</div></group></group></page><page string="Stages"><p>Rename the stages for this screen. Progress follows this order; it does not change the Odoo order.</p><group><field name="label_new"/><field name="label_acknowledged"/><field name="label_preparing"/><field name="label_ready"/><field name="label_completed"/></group></page></notebook></sheet></form></field></record>
 <record id="action_displays" model="ir.actions.act_window"><field name="name">Displays</field><field name="res_model">truth.display</field><field name="view_mode">list,form</field><field name="help" type="html"><p class="o_view_nocontent_smiling_face">Create your kitchen or bar display</p><p>Choose registers and preparation stations, then click Open Display.</p></field></record>
</odoo>
